# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown: trailing whitespace is significant (hard line breaks)
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# JSON
[*.json]
indent_size = 2

# YAML
[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2

