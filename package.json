{
  "name": "formbuilder",
  "displayName": "FormBuilder",
  "description": "Visual drag-and-drop form builder built with Next.js, React and TypeScript",
  "license": "MIT",
  "author": {
    "name": "DraugSköll",
    "email": "kprinny@gmail.com"
  },
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/reisene/formbuilder.git"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22.0"
  },
  "type": "module",
  "private": true,
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss,md,mdx,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/config": "^0.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "bootstrap": "^5.3.8",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-icons": "^5.7.0",
    "sass": "^1.102.0",
    "typewriter-effect": "^2.22.0",
    "uuid": "^14.0.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
